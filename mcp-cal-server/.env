# Copy to .env for local development. In production, set these as real
# environment variables / secrets - never commit a real .env file.

MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO

# Comma-separated list of allowed origins. Do not use "*" in production.
MCP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set this to enable bearer-token auth. Leave unset to disable (local dev only).
# MCP_AUTH_TOKEN=change-me
